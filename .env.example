# ─────────────────────────────────────────────────────
# E-COMMERCE CUSTOMER SUPPORT CHATBOT — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit your actual .env to version control.
# ─────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────
PORT=3000
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_support

# ── Shopify ──────────────────────────────────────────
# Your Shopify store subdomain (without .myshopify.com)
SHOPIFY_STORE_DOMAIN=trevolk-apple-demo.myshopify.com
# Admin API Access Token from Shopify Partner Dashboard
SHOPIFY_ADMIN_API_TOKEN=your_shopify_admin_api_token_here
# API version — keep pinned, update intentionally
SHOPIFY_API_VERSION=2024-01

# ── Gemini (Primary LLM) ─────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Groq (Fallback LLM) ──────────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── LLM Behaviour ────────────────────────────────────
# Max milliseconds to wait for Gemini before falling back to Groq
LLM_TIMEOUT_MS=8000

# ── Escalation — Discord Webhook ─────────────────────
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks
# Set DISCORD_WEBHOOK_ENABLED=false to disable
DISCORD_WEBHOOK_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ── Escalation — Email (Nodemailer / SMTP) ────────────
# Set EMAIL_ENABLED=false to disable email escalation notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
# Comma-separated list of founder email addresses to notify
ESCALATION_NOTIFY_EMAILS=founder1@example.com,founder2@example.com
ESCALATION_FROM_EMAIL=noreply@trevolk.com

# ── Rate Limiting ─────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ── Session ──────────────────────────────────────────
# How many conversation turns to retain in memory per session
SESSION_MAX_TURNS=20
# How many milliseconds before an idle session is evicted
SESSION_TTL_MS=1800000
